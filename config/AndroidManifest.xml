<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — Configuración para publicación en Google Play Store
  Se declaran únicamente los permisos estrictamente necesarios (principio de mínimo privilegio)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PERMISOS REQUERIDOS
      La app de Control de Tareas NO requiere permisos sensibles.
      Solo se declara INTERNET en caso de futuras actualizaciones con sincronización.
      Esto mejora la puntuación de seguridad en Play Store.
    -->

    <!-- Permiso para recibir notificaciones de alarma en versiones modernas de Android -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SDK mínimo y objetivo para compatibilidad con Play Store -->
    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <application
        android:label="Control de Tareas"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/LaunchTheme">

        <!-- Configuración del Activity principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Pantalla de inicio de la app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Soporte para Flutter -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

</manifest>
